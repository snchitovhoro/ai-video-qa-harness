{
  "name": "ai-video-qa-harness",
  "version": "1.0.0",
  "description": "AI-powered video generation QA automation framework using TypeScript, Playwright, and Express",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:video": "playwright test",
    "generate:report": "ts-node src/index.ts"
  },
  "keywords": [
    "typescript",
    "playwright",
    "qa",
    "automation",
    "ai",
    "video-generation",
    "testing",
    "express",
    "llm",
    "quality-engineering"
  ],
  "author": "Simbarashe Chitovhoro",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "playwright": "^1.54.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}